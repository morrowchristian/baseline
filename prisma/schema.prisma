// Baseline — construction job costing & crew scheduling.
// Postgres (Neon) everywhere — dev and prod share one provider, one
// adapter, one code path. DATABASE_URL is the Neon connection string
// (see README.md and .env.example).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL lives in prisma.config.ts (Prisma 7 removed `url` from the schema).
}

enum JobStatus {
  planned
  active
  complete
}

enum CostCategory {
  Labor
  Materials
  Equipment
  Subcontractor
  Other
}

enum UserRole {
  OWNER
  PROJECT_MANAGER
  CREW
  VIEWER
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CREW)
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  crewMemberId Int?        @unique
  createdAt    DateTime    @default(now())
}

model Job {
  id             Int                  @id @default(autoincrement())
  name           String
  client         String
  jobSiteAddress String
  status         JobStatus            @default(planned)
  budget         Decimal
  createdAt      DateTime             @default(now())
  costEntries    CostEntry[]
  timeLogs       TimeLog[]
  assignments    ScheduleAssignment[]
}

model CostEntry {
  id          Int          @id @default(autoincrement())
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       Int
  category    CostCategory
  amount      Decimal
  date        DateTime
  description String
  vendor      String?
  createdAt   DateTime     @default(now())

  @@index([jobId, date])
}

model CrewMember {
  id          Int                  @id @default(autoincrement())
  name        String
  role        String
  hourlyRate  Decimal?
  timeLogs    TimeLog[]
  assignments ScheduleAssignment[]
  user        User?
}

model TimeLog {
  id           Int        @id @default(autoincrement())
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  crewMemberId Int
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        Int
  date         DateTime
  hours        Decimal
  task         String
  createdAt    DateTime   @default(now())

  @@index([jobId, date])
  @@index([crewMemberId, date])
}

model ScheduleAssignment {
  id           Int        @id @default(autoincrement())
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  crewMemberId Int
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        Int
  date         DateTime
  createdAt    DateTime   @default(now())

  // One job per crew member per day — prevents double-booking someone.
  @@unique([crewMemberId, date])
  @@index([date])
}
