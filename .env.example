# Copy to .env for local dev, and set the same variables in Vercel for
# production. No real value belongs in the repo.
# Neon Postgres connection string (pooled; strip channel_binding=require).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js secret — signs the session JWT. Generate one with
# `openssl rand -base64 32`. Required in production (Vercel); without it
# sign-in will fail at runtime.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
